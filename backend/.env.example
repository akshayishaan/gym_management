# External MongoDB deployment (Atlas or another transaction-capable cluster).
# Credentials can be embedded in the URI. If they are, leave the two fields below empty.
# MONGODB_USERNAME and MONGODB_PASSWORD must be provided together (both or neither).
MONGODB_URI=mongodb+srv://cluster.example.mongodb.net/gym_management?retryWrites=true&w=majority
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Auth secrets (used by later issues; not validated by the scaffold yet)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Redis connection (cache / rate-limit; used by later issues)
REDIS_URL=

# Server port (defaults to 3001 if unset)
PORT=3001
