# =============================================================================
# Production environment template for the VM deployment.
#
# THIS FILE IS A TEMPLATE ONLY. The real `backend/.env` lives on the VM and is
# NEVER committed (it is gitignored via the root `.gitignore` `.env*` rule).
# Copy this to `backend/.env` on the VM and fill in real values.
#
#   cp .env.production.example .env
#   chmod 600 .env
# =============================================================================

# --- MongoDB root credentials (REQUIRED — no default in prod) -----------------
# Used both to bootstrap the Mongo replica set and embedded in the backend's
# MONGODB_URI. Generate strong values, e.g. `openssl rand -hex 24`.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# --- Auth secrets (REQUIRED — no default in prod) ----------------------------
# Access-token and refresh-token signing secrets. Generate strong values.
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Backend image (OPTIONAL override) ---------------------------------------
# Defaults to `ghcr.io/akshayishaan/gym_management/backend:latest`. Set this to
# a specific SHA tag to roll back, e.g.:
#   BACKEND_IMAGE=ghcr.io/akshayishaan/gym_management/backend:<sha>
BACKEND_IMAGE=

# --- Server port (OPTIONAL) --------------------------------------------------
# The backend always listens on 3001 inside the container and is published to
# the host on 3001. Leave unset unless you need to change the host port.
PORT=3001
