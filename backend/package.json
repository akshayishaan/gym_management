{
  "name": "gym-management-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS + Mongoose backend for the multi-tenant gym SaaS (migration from Next.js)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "docker compose -f docker-compose.dev.yml up -d --wait && nest start --watch",
    "stop:dev": "docker compose -f docker-compose.dev.yml down",
    "start:prod": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "openapi:export": "ts-node scripts/export-openapi.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "ioredis": "^5.11.1",
    "mongoose": "^8.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.4",
    "openapi3-ts": "^4.6.1",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
