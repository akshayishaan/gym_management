# Local development against the MongoDB replica set from docker-compose.
# directConnection keeps the host client on localhost even though the replica
# set advertises its Docker hostname internally.
MONGODB_URI=mongodb://localhost:27017/gym_management?replicaSet=rs0&directConnection=true

# NextAuth
NEXTAUTH_SECRET=change_this_to_a_random_secret_string
NEXTAUTH_URL=http://localhost:3000

# Initial admin account (used by seed script)
SEED_ADMIN_EMAIL=admin@gym.com
SEED_ADMIN_PASSWORD=admin123
SEED_GYM_NAME=My Gym
