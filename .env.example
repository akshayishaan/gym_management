# External MongoDB deployment (Atlas or another transaction-capable cluster).
# Credentials can be embedded in the URI. If they are, leave the two fields below empty.
MONGODB_URI=mongodb+srv://cluster.example.mongodb.net/gym_management?retryWrites=true&w=majority
MONGODB_USERNAME=
MONGODB_PASSWORD=

# NextAuth
NEXTAUTH_SECRET=change_this_to_a_random_secret_string
# Use http://localhost:3000 locally; set this to the production https URL in Vercel.
NEXTAUTH_URL=http://localhost:3000
